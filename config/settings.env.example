# Steelbound — settings template (EXAMPLE — copy, rename, fill in).
#
# How Steelbound is actually configured — read this first:
#   Steelbound has NO config-file or environment settings layer.
#   Settings (src/steelbound/config.py) is a dataclass filled from
#   CLI flags only:
#     steelbound --data-dir DIR --provider NAME [--auto-local] <cmd>
#   There is therefore no core.toml in this project: no code would
#   read it. The variables below exist for the deployment wrappers
#   (systemd EnvironmentFile, Compose env_file, your own shell) so a
#   deployment has one documented place for its choices. Except where
#   noted, Steelbound itself does not read them — the wrappers turn
#   them into CLI flags.
#
# Copy to settings.env (never commit a filled-in copy if it holds a
# secret) and reference it from your unit / compose override.
# Placeholders only — no real values belong in this example.

# --- Data directory ---------------------------------------------------
# Maps to the global CLI flag:  steelbound --data-dir "$STEELBOUND_DATA_DIR" ...
# Holds the append-only ledger database (steelbound.db) and workspace/.
# Back this directory up; it IS Steelbound's memory and history.
STEELBOUND_DATA_DIR=/var/lib/steelbound

# --- Provider ---------------------------------------------------------
# Maps to the global CLI flag:  --provider "$STEELBOUND_PROVIDER"
# One of: offline | steelbound | ollama | openai-compatible
#   offline            (DEFAULT) deterministic, no network, no keys.
#                      Always works; use it unless you mean otherwise.
#   steelbound         Steelbound's own trained model (local checkpoint).
#   ollama             Transitional: local Ollama at http://127.0.0.1:11434.
#   openai-compatible  Transitional: needs a model + base URL configured
#                      in code (the CLI does not expose them) and the
#                      key variable below.
STEELBOUND_PROVIDER=offline

# --- Serve port -------------------------------------------------------
# Maps to:  steelbound ... serve --host 127.0.0.1 --port "$STEELBOUND_PORT"
# The host is NOT configurable beyond loopback: server.py refuses any
# non-loopback bind (127.0.0.1, localhost, ::1) before opening a socket.
STEELBOUND_PORT=8765

# --- Local-write auto-approval ----------------------------------------
# Maps to the global CLI flag --auto-local (Settings field
# auto_approve_local_writes, default False).
#   false (DEFAULT, recommended): WRITE_LOCAL tools are denied unless
#          each run is explicitly approved.
#   true:  local sandbox writes are auto-approved by the gate.
# WARNING: setting this to true widens what the core may do without
# asking. Leave it false unless you have read gate.py and accept that.
STEELBOUND_AUTO_APPROVE_LOCAL_WRITES=false

# --- The one variable Steelbound code actually reads ------------------
# STEELBOUND_API_KEY is read by OpenAICompatibleProvider
# (src/steelbound/providers.py, parameter api_key_env, default
# "STEELBOUND_API_KEY") — and only when that provider is configured
# programmatically; the CLI cannot select it with a key on its own.
# Leave unset for the offline / steelbound / ollama providers.
# NEVER put a real key in this example file; set it in your private
# settings.env or your secret manager instead.
#STEELBOUND_API_KEY=<placeholder-set-in-private-settings.env>
